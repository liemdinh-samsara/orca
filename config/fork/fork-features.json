{
  "schemaVersion": 1,
  "upstream": {
    "remote": "upstream",
    "url": "https://github.com/stablyai/orca.git",
    "branch": "main"
  },
  "exempt": ["**/*.md", "docs/**"],
  "features": [
    {
      "id": "fork-sync-tooling",
      "title": "Fork contract gate and weekly upstream sync",
      "commits": [],
